PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
# Domain website dùng cho canonical, sitemap và Google Search Console.
PUBLIC_SITE_URL=https://rymz.space
# Chuỗi bí mật riêng dùng để ký link tải tạm thời. Hãy tạo chuỗi ngẫu nhiên dài.
DOWNLOADER_SIGNING_SECRET=replace-with-a-long-random-secret
# SEO, đo lường và kiếm tiền. Để trống cho tới khi tài khoản tương ứng được duyệt.
PUBLIC_CONTACT_EMAIL=contact@rymz.space
GOOGLE_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
ADSENSE_CLIENT_ID=
ADSENSE_TOP_SLOT=
ADSENSE_CONTENT_SLOT=
# Ví dụ sau khi AdSense cấp publisher ID: google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0
ADS_TXT=
META_GRAPH_VERSION=v23.0
META_FACEBOOK_SCOPES=pages_show_list
META_INSTAGRAM_SCOPES=public_profile,pages_show_list,pages_read_engagement,instagram_basic,instagram_content_publish,instagram_manage_comments
# Điền thông tin app được cấp bởi từng nền tảng. Không đưa client secret vào extension.
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic,video.publish
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_SCOPES=threads_basic,threads_content_publish,threads_read_replies,threads_manage_replies
# Vercel Blob public store: bắt buộc khi dán ảnh vào comment Threads.
BLOB_READ_WRITE_TOKEN=
SESSION_SECRET=replace-me
OAUTH_STATE_SECRET=replace-with-a-long-random-secret
ACCOUNT_BUNDLE_SECRET=replace-with-a-different-long-random-secret
